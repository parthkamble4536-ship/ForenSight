# ForenSight Configuration
FORENSIGHT_APP_NAME="ForenSight"
FORENSIGHT_DEBUG=false
FORENSIGHT_HOST=127.0.0.1
FORENSIGHT_PORT=8000

# Storage & Processing Limits
FORENSIGHT_MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
FORENSIGHT_MAX_STRING_EXTRACT=5000
FORENSIGHT_MIN_STRING_LEN=4
FORENSIGHT_MAX_STRING_LEN=256

# Database
FORENSIGHT_DB_URL="sqlite:///data/forensight.db"

